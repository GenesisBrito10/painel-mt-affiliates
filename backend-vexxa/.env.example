# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3011
CORS_ORIGIN=http://localhost:3013

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://mjmcompany_user:PASSWORD@localhost:5433/mjmcompany_db?schema=public"

# Required only by legacy migration and provider-account seed scripts.
MONGO_URI=
SEED_NETWORK_HEAD_PASSWORD=
VEXXA_PROVIDER_PASSWORD=
LHT_PROVIDER_PASSWORD=
VEXXA_PROVIDER_ENCRYPTED_PASSWORD=
LHT_PROVIDER_ENCRYPTED_PASSWORD=
PROVIDER_ACCOUNT_PASSWORD=
# Token estatico Smartico da conta Bateu Bet (host boapi3). Usado so pelo
# seed prisma/setup-bateubet-provider.mjs, que grava criptografado no banco.
BATEUBET_SMARTICO_TOKEN=

# ─── Auth ────────────────────────────────────────────────────
# Must be at least 32 characters long
# Generate: openssl rand -base64 32
JWT_SECRET="change-me-minimum-32-chars-required!!"
JWT_EXPIRATION=7d

# ─── Encryption ──────────────────────────────────────────────
# Must be at least 32 characters long
# Generate: openssl rand -base64 32
ENCRYPTION_KEY="change-me-minimum-32-chars-required!!"

# ─── Seletor de gateway de pagamento ─────────────────────────
# Escolhe qual gateway processa os saques PIX: 'heartpay' ou 'vorexy'.
# Default (ausente) = vorexy. Cada gateway usa suas próprias credenciais abaixo
# e seu próprio webhook (/api/v1/webhooks/heartpay ou /api/v1/webhooks/vorexy).
PAYMENT_GATEWAY=vorexy

# ─── HeartPay Payment Gateway ────────────────────────────────
# API credentials issued in HeartPay dashboard → Integrations.
HEARTPAY_BASE_URL=https://app.heartpag.com
HEARTPAY_API_KEY=hpay_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing token used to validate X-HeartPay-Signature (HMAC-SHA256).
# Configure the matching webhook URL in HeartPay → Webhooks pointing to
# ${APP_PUBLIC_URL}/api/v1/webhooks/heartpay
HEARTPAY_WEBHOOK_TOKEN=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
HEARTPAY_HTTP_TIMEOUT_MS=15000

# ─── Vorexy Payment Gateway (gateway PIX ativo) ──────────────
# Credenciais emitidas no painel Vorexy → Integrações.
VOREXY_BASE_URL=https://vorexy.com
VOREXY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOREXY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOREXY_COMPANY_ID=00
VOREXY_HTTP_TIMEOUT_MS=15000
# Segredo opcional do webhook — anexado na URL como ?s=<valor>. Configure a URL
# ${APP_PUBLIC_URL}/api/v1/webhooks/vorexy?s=<valor> no painel Vorexy.
VOREXY_WEBHOOK_SECRET=
# Marca exibida no comprovante PIX gerado localmente.
RECEIPT_BRAND_NAME="MT Affiliates"

# Public-facing API base (used by HeartPay to deliver webhooks).
APP_PUBLIC_URL=http://localhost:3011

# ─── Email (Resend) ─────────────────────────────────────────
# Used by password recovery and automated transactional emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="MT Affiliates <suporte@mtafiliates.com.br>"
# Affiliate panel URL used in password reset links and automated email CTAs.
AFFILIATE_PANEL_URL=https://affiliates.mtafiliates.com.br
# Optional: receive a copy of Superbet inactivity warning emails for testing/monitoring.
SUPERBET_INACTIVITY_EMAIL_COPY_TO=

# ─── Cloudflare R2 (support-chat attachments) ────────────────
# R2 is S3-compatible. The browser uploads images/PDFs through the backend
# (proxy upload) which forwards them to R2 via the AWS SDK. The bucket only
# needs public GET access on the public URL — no CORS needed since the
# browser never talks to R2 directly.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=vexxa-support-attachments
# Public-facing base URL (custom domain or pub-XXXX.r2.dev). No trailing slash.
R2_PUBLIC_URL=https://files.example.com

# ─── Link pools (Google Sheets) ──────────────────────────────────────────────
# Usa as credenciais GOOGLE_* (service account) já configuradas.
# Esportiva: planilha com colunas A=ID, B=LINK, C=EMAIL, D=STATUS.
# campaignId salvo = "VALLEXGROUP - <ID>". ESPORTIVA_SHEET_TAB opcional
# (vazio = primeira aba / gid=0).
ESPORTIVA_SHEET_ID=1Riko3Y9XCEkw0eb4-CBlvMr2Fa6umlT-Dw0XzsKMmLY
ESPORTIVA_SHEET_TAB=

# Sportingbet: aba Links; campos obrigatórios lidos por cabeçalho:
# Afiliado, Tipo de Link, URL, STATUS e EMAIL.
# campaignId salvo = "<AfiliadoSemEspacos>::<Tipo de Link>".
SPORTINGBET_SHEET_ID=1J4lnIYIAku2H5-R4WoJtVpZ56b8YQ6JIZOfrvld6la0
SPORTINGBET_SHEET_TAB=Links

# Betano Diário: pool na aba LINKS (LINK, STATUS, E-MAIL) e métricas em abas
# diárias dd/MM/yyyy (LINKS, CLICKS, REGISTROS, FTDs, FTD AMOUNT, CPA).
BETANO_DIARIO_SHEET_ID=1NPeKinpO5pRlhmJKkDQ8RRE8nZE1bhJAvyTEMrZH2v4
BETANO_DIARIO_SHEET_TAB=LINKS

# Credenciais do painel Partners OTG. O script setup-sportingbet-otg.mjs
# criptografa a senha antes de persistir em ProviderAccount.
SPORTINGBET_OTG_EMAIL=
SPORTINGBET_OTG_PASSWORD=
