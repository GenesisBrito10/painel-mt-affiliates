  amount       Decimal @db.Decimal(14, 2)
  bettingHouse String?
  campaignId   String?
  sourceUserId String?

  referenceId   String?
  referenceType String?
  description   String  @default("")

  eventDate DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([userId, eventDate(sort: Desc)])
  @@index([userId, eventType])
  @@index([userId, bettingHouse])
  @@map("financial_ledger")
}

enum LinkWebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// Webhook de solicitação de link — config por dono (ownerUserId null = global/admin)
model LinkWebhookSettings {
  id            String   @id @default(uuid())
  enabled       Boolean  @default(false)
  webhookUrl    String   @default("")
  // AES-256-GCM encrypted (CryptoService). Empty string = no secret set.
  webhookSecret String   @default("")
  // Subscribed event types (see LINK_WEBHOOK_EVENTS). Replaces the old
  // notifyOnApproved/notifyOnRejected booleans. Backfilled by migration.
  events        String[] @default(["link_request.approved", "link_request.rejected"])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ownerUserId   String?  @unique
  owner         User?    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@map("link_webhook_settings")
}

model LinkWebhookDelivery {
  id             String                    @id @default(uuid())
  // Nullable: non-link events (affiliate_data.synced, deal.updated, ...) have
  // no associated link request.
  linkRequestId  String?
  event          String
  origin         String
  idempotencyKey String                    @unique
  payload        Json
  status         LinkWebhookDeliveryStatus @default(PENDING)
  httpStatus     Int?
  responseBody   String?
  errorMessage   String?
  attempts       Int                       @default(0)
  deliveredAt    DateTime?
  createdAt      DateTime                  @default(now())
  ownerUserId    String?
  linkRequest    LinkRequest?              @relation(fields: [linkRequestId], references: [id], onDelete: SetNull)
  owner          User?                     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([linkRequestId])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([event, createdAt(sort: Desc)])
  @@map("link_webhook_deliveries")
}

// ─── ENUMS: SUPPORT CHAT ────────────────────────────────────

enum ConversationStatus {
  WAITING
  OPEN
  WAITING_USER
  CLOSED
}

enum MessageSenderRole {
  AFFILIATE
  AGENT
}

// ─── SUPPORT CHAT ───────────────────────────────────────────

