// ─── RANKING PRIZE ──────────────────────────────────────────

model RankingPrize {
  id              String        @id @default(uuid())
  title           String
  description     String        @default("") @db.Text
  prizeType       PrizeType     @default(OTHER)
  prizeValue      Decimal       @default(0) @db.Decimal(14, 2)
  prizeLabel      String        @default("")
  icon            String        @default("🏆")
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  winnersCount    Int           @default(1)
  targetCpa       Int           @default(0)
  // null = conta CPA de todas as casas; slug = conta CPA só dessa casa
  bettingHouse    String?
  bettingHouseRef BettingHouse? @relation(fields: [bettingHouse], references: [slug])
  winMode         PrizeWinMode  @default(RANKING)
  // false = meta/ranking conta CPA da produção INDIVIDUAL do afiliado;
  // true = conta CPA da REDE (downline) do afiliado. Usado p/ modo TARGET (meta de CPA).
  cpaFromNetwork  Boolean       @default(false)
