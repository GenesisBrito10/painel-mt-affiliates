  newValue        Decimal?      @db.Decimal(10, 4)
  // Origem da mudança: APPROVAL | ASSIGNMENT | ADMIN_EDIT | SYNC | RESTORE | SCRIPT
  source          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, bettingHouse])
  @@map("commission_logs")
