// ─── REFRESH TOKEN ──────────────────────────────────────────
// Secure token rotation: SHA-256 hash stored, familyId for reuse detection.
// On refresh: old token revoked, new token issued with same familyId.
// On reuse detection (revoked token presented): entire family revoked.

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique // SHA-256 of the raw token (never store plaintext)
  familyId  String // groups tokens from the same login session
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── FINANCIAL LEDGER ───────────────────────────────────────
