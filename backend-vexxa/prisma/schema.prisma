// ============================================================
// VeXXa — Prisma Schema v3 (PostgreSQL 16)
// 22 tabelas | Audit v1 (28 findings) + Audit v2 (6 schema fixes)
//
// V2 corrections applied:
//   4.1 CommissionLog: userName/userEmail denormalized
//   4.2 LinkRequest: removed duplicate bettingHouse field
//   4.3 RankPrize/PrizeWinner: added createdAt/updatedAt
//   4.4 WithdrawalRequest: bettingHouse NOT NULL (house-segregation)
//   D08 SyncLog: periodoInicio→periodStart, stats prefix removed
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────────

enum UserRole {
  AFFILIATE
  SUPPORT
  ADMIN
  SUPERADMIN
}

enum LoginModalAudience {
  ALL
  AFFILIATE
  HEAD_AFFILIATE
  SUPPORT
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum PinbetTrackingDimension {
  AFP1
  AFP2
  COMBINED
}

enum LinkRequestStatus {
  PENDING
  FULFILLED
  REJECTED
}

// Origem de um AffiliateLink — distingue link real de placeholder/commission-only.
// "Link real ativo" = deletedAt IS NULL AND source IN (POOL, MANUAL).
enum LinkSource {
  POOL
  MANUAL
  COMMISSION_ONLY
  PLACEHOLDER
}

// Tipo de cálculo de CPA configurado por casa.
enum LinkRuleType {
  INVITER_DISCOUNT
  RANGE
  // CPA = CPA do PRÓPRIO usuário na casa de referência (1:1, sem faixa/desconto).
  MIRROR
}

enum LinkAssignmentRuleApplied {
  DEFAULT
  INVITER_MINUS_DISCOUNT
  FALLBACK
  RANGE_RULE
  // CPA espelhado 1:1 da casa de referência (regra MIRROR).
  MIRROR_REFERENCE
  BLOCKED
  ALREADY_HAS_LINK
}

enum LinkAssignmentOutcome {
  LINK_ASSIGNED
  WAITING_POOL_LINK
  WAITING_SNAPSHOT
  SKIPPED_AUTO_ASSIGN
  WAITING_MANUAL_REVIEW
  BLOCKED
  SKIPPED
}

enum LinkAssignmentOrigin {
  NEW_REQUEST
  BACKFILL_OLD_REQUESTS
  ADMIN_REPROCESS
  ADMIN_OVERRIDE
}

enum BackfillRunStatus {
  RUNNING
  DONE
  FAILED
  FAILED_STALE
}

enum SyncMode {
  AUTO
  MANUAL
}

enum SyncLogStatus {
  RUNNING
  SUCCESS
  ERROR
}

enum PrizeStatus {
  ACTIVE
  ENDED
  FINALIZED
}

enum PrizeType {
  BALANCE
  PHYSICAL
  OTHER
}

// Prize win mode: RANKING = top N by most CPA; TARGET = top N among those who reach a CPA goal.
enum PrizeWinMode {
  RANKING
  TARGET
}

enum NotificationType {
  REGISTRATION
  COMMISSION_CHANGE
  WITHDRAWAL_APPROVED
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_FAILED
  STATUS_CHANGE
  GENERAL
  WHATSAPP_DISCONNECTED
  LINK_POOL_FULL
  DEAL_FORM_APPROVED
}

// Estado de cada tentativa de envio de comprovante ao WhatsApp.
//   WAITING_CONNECTION → instância desconectada (reagenda, não consome tentativa)
//   PAUSED             → circuit breaker aberto (reagenda até circuitOpenUntil)
enum WhatsappSendStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  WAITING_CONNECTION
  PAUSED
  CANCELLED
}

enum DepositComplianceStatus {
  PASS
  FAIL
  EXEMPT
  PENALTY_APPLIED
}

enum DepositComplianceFailReason {
  MY_DATA_BELOW
  TEAM_BELOW
  BOTH_BELOW
}

enum LedgerEventType {
  COMMISSION_CPA
  COMMISSION_REVSHARE
  NETWORK_CPA
  NETWORK_REVSHARE
  FRAUD_DEDUCTION_DIRECT
  FRAUD_DEDUCTION_NETWORK
  WITHDRAWAL_APPROVED
  BONUS_CREDIT
  MANUAL_ADJUSTMENT
}

enum LedgerEventStatus {
  CONFIRMED
  PENDING
  REVERSED
}

// ─── CORE: USER ─────────────────────────────────────────────
// F01: Decimal for money | F04: CHECK lower(email) via migration
// F12: Composite index for admin listing | F15: onDelete policies
// F27: Soft delete via deletedAt

model User {
  id                   String     @id @default(uuid())
  name                 String
  email                String     @unique
  password             String // bcrypt hash (CHECK >= 60 chars via migration)
  role                 UserRole   @default(AFFILIATE)
  status               UserStatus @default(PENDING)
  active               Boolean    @default(true)
  ageVerified          Boolean    @default(false)
  withdrawalBlocked    Boolean    @default(false)
  // Quando true, o usuário vê deals marcadas como exclusive=true.
  // Admin/superadmin sempre vê tudo. Default false → usuário comum.
  exclusiveDealsAccess Boolean    @default(false)
  // Liberado pelo admin: dá acesso às features de API e Webhook (abas + rotas).
  // Admin/superadmin sempre tem acesso. Default false → bloqueado.
  apiAccessEnabled     Boolean    @default(false)
  bonusBalance         Decimal    @default(0) @db.Decimal(14, 2)
  // Manual per-affiliate balance credit/debit (forgive overpaid negative
  // balances so future earnings count fresh). Now PER-HOUSE — see the
  // BalanceAdjustment model / `balanceAdjustments` relation below.
  referralCode         String?    @unique
  referredById         String?
  referredBy           User?      @relation("UserReferrals", fields: [referredById], references: [id])
  referrals            User[]     @relation("UserReferrals")

  // Removed: commissionCpa/commissionRevShare — no fallback, per-house via affiliateLinks only

  // Payment info (always fetched together → flat, F18 decision: keep denormalized)
  pixKeyType    String @default("")
  pixKey        String @default("")
  bankName      String @default("")
  bankAgency    String @default("")
  bankAccount   String @default("")
  accountHolder String @default("")

  // KYC — identity verification (F-KYC-01)
  // cpf and birthDate are IMMUTABLE after first submission — change only via support
  cpf              String?   @unique // 11 digits, validated by CPF algorithm
  birthDate        DateTime? // must be >= 18 years at submission time
  whatsapp         String? // E.164-compatible, e.g. +5511999990000
  profileCompleted Boolean   @default(false) // true only when all KYC fields are present
  avatarUrl        String?

  // Deposit compliance
  depositComplianceAlertCount  Int       @default(0)
  depositCompliancePenalizedAt DateTime?

  // Superbet inactivity compliance
  superbetInactiveDays Int       @default(0)
  superbetLastActiveAt DateTime?

  // External panel users (third-party API). isExternal users are shadow
  // accounts created via the affiliate API for a third party's own panel
  // users. They CANNOT log in (blocked in auth) and are EXCLUDED from
  // affiliate counts/rankings. externalId = the id in the third party's panel,
  // unique within the owner (referredById) scope.
  isExternal    Boolean @default(false)
  externalId    String?
  // Real e-mail of an external sub-user as received from the partner. Stored
  // here (NON-unique) instead of `email` so a clash with an existing account
  // never hijacks/merges identities — `email` stays synthetic for externals.
  // Used for display ("email estranho" sintético nunca é exibido) and search.
  externalEmail String?

  // Soft delete (F27)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations 1:N
  affiliateLinks            AffiliateLink[]
  fraudCounts               FraudCount[]
  balanceAdjustments        BalanceAdjustment[]
  withdrawalRequests        WithdrawalRequest[]    @relation("WithdrawalUser")
  approvedWithdrawals       WithdrawalRequest[]    @relation("WithdrawalApprover")
  linkRequests              LinkRequest[]          @relation("LinkRequestUser")
  fulfilledLinkRequests     LinkRequest[]          @relation("LinkRequestFulfiller")
  notifications             Notification[]
  commissionLogsReceived    CommissionLog[]        @relation("CommissionLogUser")
  commissionLogsChanged     CommissionLog[]        @relation("CommissionLogChanger")
  auditLogs                 AuditLog[]
  fraudLogsReceived         FraudLog[]             @relation("FraudLogUser")
  fraudLogsChanged          FraudLog[]             @relation("FraudLogChanger")
  fraudCountsUpdated        FraudCount[]           @relation("FraudCountUpdater")
  balanceAdjustmentsUpdated BalanceAdjustment[]    @relation("BalanceAdjustmentUpdater")
  depositComplianceLogs     DepositComplianceLog[]
  pushSubscriptions         PushSubscription[]
  notificationSnapshots     NotificationSnapshot[]
  refreshTokens             RefreshToken[]
  passwordResetTokens       PasswordResetToken[]
  prizesCreated             RankingPrize[]         @relation("PrizeCreator")
  prizesFinalized           RankingPrize[]         @relation("PrizeFinalizer")
  prizeWins                 PrizeWinner[]
  financialLedger           FinancialLedger[]
  linkWebhookSettings       LinkWebhookSettings?
  linkWebhookDeliveries     LinkWebhookDelivery[]
  affiliateApiTokens        AffiliateApiToken[]
  cpaPrizeRulesCreated      CpaPrizeRule[]         @relation("CpaPrizeRuleCreator")
  cpaPrizeAwards            CpaPrizeAward[]
  cpaPrizeProgress          CpaPrizeProgress[]
  withdrawalDayReleases     WithdrawalDayRelease[]

  // Support Chat relations
  conversationsAsAffiliate SupportConversation[]           @relation("ConversationAffiliate")
  conversationsAsAgent     SupportConversation[]           @relation("ConversationAgent")
  supportMessages          SupportMessage[]                @relation("MessageSender")
  supportAssignments       SupportConversationAssignment[] @relation("AssignmentAgent")
  agentAvailability        SupportAgentAvailability?       @relation("AgentAvailability")

  // External panel user uniqueness within an owner's scope. NULL externalId
  // (real affiliates) never collide — Postgres treats NULLs as distinct.
  @@unique([referredById, externalId], name: "uq_owner_external")
  // F12: Composite for admin listing (replaces individual role/status indexes)
  @@index([role, status, createdAt(sort: Desc)])
  @@index([referredById])
  @@index([deletedAt])
  @@index([externalEmail])
  @@map("users")
}

// ─── WITHDRAWAL DAY RELEASE ─────────────────────────────────
// Libera 1 saque EXTRA por casa no dia (bypass do rate-limit 1/dia/casa).
// Concedida pelo admin; consumida quando o saque extra é criado.
model WithdrawalDayRelease {
  id            String    @id @default(uuid())
  userId        String
  bettingHouse  String
  releaseDate   DateTime // início do dia (local) — casa com a janela do rate-limit
  consumedAt    DateTime? // null = disponível
  reason        String?
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, bettingHouse, releaseDate, consumedAt], map: "withdrawal_day_releases_lookup_idx")
  @@map("withdrawal_day_releases")
}

// ─── AFFILIATE LINK ─────────────────────────────────────────
// Vincula um user a uma casa de aposta com suas taxas de comissão.
// campaignId = ID da campanha no dashboard da casa (ex: ngx_source_id da Lottu)
// Cada link é isolado POR CASA — comissões nunca cruzam entre casas.

model AffiliateLink {
  id                String           @id @default(uuid())
  userId            String
  // Restrict (não Cascade): impede que apagar/cascade de User leve junto o
  // link/cpa/campaignId. Remoção de afiliado é soft-delete (User.deletedAt).
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  bettingHouse      String // slug (lowercase) — DIMENSÃO DE ISOLAMENTO
  bettingHouseRef   BettingHouse?    @relation(fields: [bettingHouse], references: [slug])
  affiliateId       String           @default("") // = affiliateName do MongoDB (ID único da campanha no provedor)
  campaignId        String // REQUIRED — ID da campanha na casa, globalmente único por casa
  cpa               Decimal?         @db.Decimal(10, 4)
  revshare          Decimal?         @db.Decimal(10, 4)
  // URL de afiliado que o usuário compartilha (link de divulgação).
  userLink          String?
  // Dimensão de campanha retornada pelo provedor (ex.: Telegram na Sportingbet).
  linkType          String?
  // Origem do vínculo. Só POOL/MANUAL contam como "link real ativo" (ver enum
  // LinkSource). placeholder `pending_*`/commission-only NÃO contam para
  // checagem de link/duplicidade/dependência/eligibility.
  source            LinkSource       @default(POOL)
  // Painel (conta de provedor) — enriquecido pelo sync quando o
  // par (campaignId, bettingHouse) coincide com uma row de AffiliateData.
  providerAccountId String?
  providerAccount   ProviderAccount? @relation(fields: [providerAccountId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  // Soft delete: NUNCA hard-delete (preserva campaignId/link/cpa). Hard-delete
  // é bloqueado na extensão Prisma (prisma-audit.extension). Ver migração que
  // cria o índice único PARCIAL uq_campaign_house_active WHERE "deletedAt" IS NULL.
  deletedAt         DateTime?

  // Unicidade (campaignId,bettingHouse) é garantida por ÍNDICE PARCIAL no DB
  // (apenas linhas ativas, deletedAt IS NULL) — não declarável no Prisma, ver migração.
  @@index([userId, bettingHouse])
  @@index([providerAccountId])
  @@index([deletedAt])
  @@map("affiliate_links")
}

// ─── FRAUD COUNT ────────────────────────────────────────────
// F14: Added FK for updatedById

model FraudCount {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bettingHouse    String
  bettingHouseRef BettingHouse? @relation(fields: [bettingHouse], references: [slug])
  count           Int           @default(0)
  updatedById     String?
  updatedBy       User?         @relation("FraudCountUpdater", fields: [updatedById], references: [id])
  updatedAt       DateTime      @updatedAt

  @@unique([userId, bettingHouse])
  @@map("fraud_counts")
}

// Manual per-affiliate balance credit/debit, PER HOUSE (mirrors FraudCount).
// `amount` is added to that house's earnings (and to baseGross). Set manually
// in the DB — forgives overpaid (negative) balances so future earnings count
// fresh, isolated per house instead of via a single global figure.
model BalanceAdjustment {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bettingHouse    String
  pinbetDimension PinbetTrackingDimension?
  bettingHouseRef BettingHouse? @relation(fields: [bettingHouse], references: [slug])
  amount          Decimal       @default(0) @db.Decimal(14, 2)
  reason          String?
  updatedById     String?
  updatedBy       User?         @relation("BalanceAdjustmentUpdater", fields: [updatedById], references: [id])
  updatedAt       DateTime      @updatedAt

  @@unique([userId, bettingHouse])
  @@index([bettingHouse, pinbetDimension])
  @@map("balance_adjustments")
}

// ─── AFFILIATE DATA (métricas de performance POR CASA) ─────
// Tabela MAIS CONSULTADA — todos os dashboards leem daqui.
// ISOLAMENTO: cada row pertence a UMA casa (bettingHouse) e UMA campanha (campaignId).
// Queries SEMPRE filtram por bettingHouse — nunca agregam cross-house.

model AffiliateData {
  id              String        @id @default(uuid())
  affiliateId     String        @default("") // = affiliateName do MongoDB (ID único no provedor)
  campaignId      String // ID da campanha na casa — deve = affiliateName do Mongo
  bettingHouse    String // slug (lowercase) — DIMENSÃO DE ISOLAMENTO
  bettingHouseRef BettingHouse? @relation(fields: [bettingHouse], references: [slug])
  campaignName    String        @default("default") // nome do projeto/campanha dentro da casa
  utmCampaign     String        @default("") // conta/painel do sync
  date            DateTime      @db.Date
  clicks          Int           @default(0)
  registrations   Int           @default(0)
  ftds            Int           @default(0)
  qftd            Int           @default(0)
  deposit         Decimal       @default(0) @db.Decimal(14, 2)
  netPl           Decimal?      @db.Decimal(14, 2)
  withdrawalTotal Decimal?      @db.Decimal(14, 2)
  volume          Decimal?      @db.Decimal(14, 2)
  revShare        Decimal       @default(0) @db.Decimal(14, 2)
  cpaQualified    Int           @default(0)
  cpaValue        Decimal       @default(0) @db.Decimal(14, 2)
  totalCommission Decimal       @default(0) @db.Decimal(14, 2)
  source          String        @default("otg-api")
  lastSyncAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // 1 registro por campanha + casa + dia + projeto + utm
  @@unique([campaignId, bettingHouse, date, campaignName, utmCampaign], name: "uq_affiliate_data")
  @@index([affiliateId, bettingHouse, date])
  @@index([bettingHouse, date])
  @@index([campaignId, bettingHouse])
  @@index([campaignId, bettingHouse, date, campaignName]) // covering for dashboard
  @@map("affiliate_data")
}

enum AffiliateDataChangeType {
  INSERT
  UPDATE
}

/// Append-only history of meaningful changes to affiliate_data rows.
/// Only persisted when a sync UPSERT modifies a balance-relevant field
/// (cpaQualified, cpaValue, totalCommission, qftd, ftds, deposit, revShare).
/// Pure clicks/registrations updates are skipped to keep volume bounded.
/// Used to audit balance disputes ("I had R$X yesterday, now R$Y").
model AffiliateDataChangeLog {
  id              String                  @id @default(uuid())
  affiliateDataId String? // null when row was inserted (no prior state)
  campaignId      String
  bettingHouse    String
  campaignName    String
  utmCampaign     String
  date            DateTime                @db.Date
  changeType      AffiliateDataChangeType
  source          String
  syncLogId       String?
  changedAt       DateTime                @default(now())

  // Previous values — null on INSERT
  prevClicks          Int?
  prevRegistrations   Int?
  prevFtds            Int?
  prevQftd            Int?
  prevDeposit         Decimal? @db.Decimal(14, 2)
  prevNetPl           Decimal? @db.Decimal(14, 2)
  prevWithdrawalTotal Decimal? @db.Decimal(14, 2)
  prevVolume          Decimal? @db.Decimal(14, 2)
  prevRevShare        Decimal? @db.Decimal(14, 2)
  prevCpaQualified    Int?
  prevCpaValue        Decimal? @db.Decimal(14, 2)
  prevTotalCommission Decimal? @db.Decimal(14, 2)

  // New values — always set
  newClicks          Int
  newRegistrations   Int
  newFtds            Int
  newQftd            Int
  newDeposit         Decimal  @db.Decimal(14, 2)
  newNetPl           Decimal? @db.Decimal(14, 2)
  newWithdrawalTotal Decimal? @db.Decimal(14, 2)
  newVolume          Decimal? @db.Decimal(14, 2)
  newRevShare        Decimal  @db.Decimal(14, 2)
  newCpaQualified    Int
  newCpaValue        Decimal  @db.Decimal(14, 2)
  newTotalCommission Decimal  @db.Decimal(14, 2)

  @@index([campaignId, bettingHouse, date, changedAt])
  @@index([bettingHouse, changedAt])
  @@index([syncLogId])
  @@map("affiliate_data_change_logs")
}

model AffiliateApiToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  tokenHint   String
  // "live" (vex_live_) or "test" (vex_test_) — one active token per (user, environment).
  environment String    @default("live")
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([userId, environment, revokedAt])
  @@map("affiliate_api_tokens")
}

// Raw payload log of every affiliate-API link-request received. Persists EXACTLY
// what the partner sent (esp. userEmail) so the received e-mail is never lost —
// even if the shadow user falls back to a synthetic address on e-mail clash —
// enabling search, metrics and backfill keyed by externalId.
model AffiliateApiLinkRequestLog {
  id               String   @id @default(uuid())
  ownerUserId      String // the partner (real affiliate) who made the call
  externalId       String // panel user id sent by the partner
  userEmail        String // e-mail received in the payload
  userName         String // name received in the payload
  bettingHouseSlug String // house received in the payload
  dealId           String?
  message          String?
  requesterId      String? // resolved shadow user id
  // True when the shadow user's stored e-mail is synthetic (clash/absent) and
  // therefore differs from this received userEmail.
  emailSynthetic   Boolean  @default(false)
  payload          Json // full raw payload as received
  createdAt        DateTime @default(now())

  @@index([ownerUserId, createdAt])
  @@index([externalId])
  @@index([userEmail])
  @@map("affiliate_api_link_request_logs")
}

// Isolated storage for the affiliate-API SANDBOX (test mode). Production code
// NEVER reads this table, so sandbox data cannot leak into real balances,
// network earnings, admin views, rankings, metrics, or payouts.
model AffiliateApiSandboxRecord {
  id          String   @id @default(uuid())
  ownerUserId String // the partner (real affiliate) who owns the test token
  kind        String // 'user' | 'withdrawal'
  externalId  String? // sandbox sub-user key (from the partner's panel)
  refId       String? // withdrawal id, etc.
  payload     Json // entity snapshot
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerUserId, kind])
  @@map("affiliate_api_sandbox_records")
}

// ─── BETTING HOUSE ──────────────────────────────────────────
// F04: CHECK lower(slug) via migration | F25: apiKey should be encrypted

model BettingHouse {
  id                  String    @id @default(uuid())
  name                String
  slug                String    @unique // lowercase enforced via CHECK + DTO @Transform
  apiBaseURL          String    @default("")
  apiBasePath         String    @default("/api/v1")
  apiKey              String    @default("") // F25: encrypt via pgcrypto in app layer
  active              Boolean   @default(true)
  syncSchedule        String    @default("0 */2 * * *")
  syncMode            SyncMode  @default(AUTO)
  logoUrl             String    @default("")
  withdrawalDay       Int? // day of month for withdrawals start (1-31)
  withdrawalDayEnd    Int? // day of month for withdrawals end (1-31), null = same as withdrawalDay
  withdrawalDay2      Int? // 2nd monthly window start (1-31) — used for biweekly (e.g. hiperbet days 1-2 + 15-16)
  withdrawalDay2End   Int? // 2nd monthly window end (1-31), null = same as withdrawalDay2
  withdrawalWeekday   Int? // 0=Sun..6=Sat. If set, weekly cadence overrides day-of-month windows.
  minCpaToWithdraw    Int       @default(0) // minimum qualified CPAs the affiliate must have in this house to withdraw
  // Média mínima de depósito por CPA exigida NESTA casa para liberar saque
  // (antes era um único valor global). Network heads são isentos.
  minAvgDepositPerCpa Decimal   @default(70) @db.Decimal(14, 2)
  // Mínimo de saque NESTA casa. null = usa o mínimo global (min_withdrawal_amount).
  minWithdrawalAmount Decimal?  @db.Decimal(14, 2)
  withdrawalEnabled   Boolean   @default(true) // false = saques desativados para esta casa (independe de cadência)
  lastSyncAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  deals                 Deal[]
  syncLogs              SyncLog[]
  providerAccountHouses ProviderAccountHouse[]
  // FK back-relations (slug-based)
  affiliateLinks        AffiliateLink[]
  affiliateData         AffiliateData[]
  withdrawalRequests    WithdrawalRequest[]
  commissionLogs        CommissionLog[]
  fraudCounts           FraudCount[]
  balanceAdjustments    BalanceAdjustment[]
  fraudLogs             FraudLog[]
  notificationSnapshots NotificationSnapshot[]
  rankingPrizes         RankingPrize[]
  linkRule              HouseLinkRule?
  cpaPrizeRuleVersions  CpaPrizeRuleVersion[]

  @@map("betting_houses")
}

// ─── DEAL ───────────────────────────────────────────────────
// F01: Decimal for rates/money | F03: @db.Text for long text

// Tipo de deal: LINK = fluxo padrão (afiliado solicita link e admin fulfilla com
// URLs). FORM = deal cujo acesso exige preencher um formulário dinâmico (campos
// definidos em `Deal.formSchema`); a submissão vira LinkRequest com `formData`.
enum DealKind {
  LINK
  FORM
}

model Deal {
  id                     String       @id @default(uuid())
  bettingHouseSlug       String
  bettingHouse           BettingHouse @relation(fields: [bettingHouseSlug], references: [slug])
  name                   String
  // Tipo do deal — dita se o afiliado solicita link (LINK) ou preenche form (FORM).
  kind                   DealKind     @default(LINK)
  // Definição dinâmica dos campos do formulário (array de FormField), usada quando
  // kind=FORM. Editável pelo admin (construtor de formulário). null para kind=LINK.
  formSchema             Json?
  cpa                    Decimal      @default(0) @db.Decimal(10, 4)
  revshare               Decimal      @default(0) @db.Decimal(10, 4)
  baseline               Decimal      @default(0) @db.Decimal(14, 2)
  minAvgDepositPerFtd    Decimal      @default(80) @db.Decimal(14, 2)
  minQualifiedFtd        Int          @default(15)
  exclusive              Boolean      @default(false)
  featured               Boolean      @default(false)
  newArrival             Boolean      @default(false)
  sortOrder              Int          @default(0)
  paymentCpaLabel        String       @default("")
  paymentRevshareLabel   String       @default("")
  revenueType            String       @default("")
  revNegativeAccumulates Boolean      @default(false)
  revNegativeOffsetsCpa  Boolean      @default(false)
  withdrawalIndicators   String[]     @default([])
  trafficSources         String[]     @default([])
  conditionsText         String       @default("") @db.Text
  paymentNotes           String       @default("") @db.Text
  logoUrl                String       @default("")
  active                 Boolean      @default(true)
  legacyKey              String?      @unique
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  linkRequests LinkRequest[]

  @@index([bettingHouseSlug, sortOrder(sort: Desc), name])
  @@index([active])
  @@map("deals")
}

// ─── WITHDRAWAL REQUEST ─────────────────────────────────────
// F01: Decimal | F07: Partial index for PENDING via migration
// F15: onDelete RESTRICT (can't delete user with withdrawals)
// V2-4.4: bettingHouse NOT NULL — house-segregation enforced at DB level

model WithdrawalRequest {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation("WithdrawalUser", fields: [userId], references: [id], onDelete: Restrict)
  amount          Decimal          @db.Decimal(14, 2)
  originalAmount  Decimal          @default(0) @db.Decimal(14, 2)
  withdrawalFee   Decimal          @default(0) @db.Decimal(14, 2)
  bettingHouse    String // V2-4.4: NOT NULL — every withdrawal is per-house
  pinbetDimension PinbetTrackingDimension?
  bettingHouseRef BettingHouse?    @relation(fields: [bettingHouse], references: [slug])
  pixKeyType      String
  pixKey          String
  bankName        String           @default("")
  bankAgency      String           @default("")
  bankAccount     String           @default("")
  accountHolder   String
  status          WithdrawalStatus @default(PENDING)
  requestNote     String           @default("") @db.Text
  adminNote       String           @default("") @db.Text
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?            @relation("WithdrawalApprover", fields: [approvedById], references: [id])

  // HeartPay gateway integration (POST /api/v1/client/payouts)
  gatewayProvider         String?
  gatewayId               String?   @unique
  gatewayStatus           String?
  gatewayRequest          Json?
  gatewayResponse         Json?
  gatewaySentAt           DateTime?
  gatewayCompletedAt      DateTime?
  gatewayFailureReason    String?   @db.Text
  gatewayEndToEnd         String?
  gatewayReceiver         Json?
  gatewayAttempts         Int       @default(0)
  // Receipt (PNG base64) persisted after webhook delivery for PayOutCompleted.
  gatewayReceiptBase64    String?   @db.Text
  gatewayReceiptFormat    String?
  gatewayReceiptFetchedAt DateTime?
  // PayOutRefunded — recipient returned the PIX (total or partial). The
  // refunded portion is credited back to the affiliate's available balance
  // by DashboardBalanceService. Status stays COMPLETED for partial refunds;
  // full refunds flip to FAILED (handled in WithdrawalService).
  gatewayRefundedAmount   Decimal?  @db.Decimal(14, 2)
  gatewayRefundedAt       DateTime?
  gatewayRefundEndToEnd   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([bettingHouse])
  @@index([bettingHouse, pinbetDimension])
  @@index([status, createdAt(sort: Desc)]) // admin list: filter by status + paginate
  @@index([createdAt(sort: Desc)]) // admin list: no status filter
  @@index([approvedById]) // FK join when loading approvedBy user
  // GIN trigram indexes on users.name/email: see prisma/migrations/MANUAL_INDEXES.md
  @@map("withdrawal_requests")
}

// ─── GATEWAY WEBHOOK EVENT ─────────────────────────────────
// Idempotent log of every callback from payment provider.
// eventKey = sha256(provider|gatewayId|event|sent_at) — UNIQUE
// guarantees at-most-once processing under retry storms.

model GatewayWebhookEvent {
  id           String   @id @default(uuid())
  provider     String   @default("xflow")
  eventKey     String   @unique
  event        String
  gatewayId    String
  withdrawalId String?
  rawPayload   Json
  status       String   @default("processed")
  error        String?  @db.Text
  receivedAt   DateTime @default(now())

  @@index([gatewayId])
  @@index([withdrawalId])
  @@map("gateway_webhook_events")
}

// ─── LINK REQUEST ───────────────────────────────────────────
// F15: onDelete RESTRICT | F16: links as Json (validated in DTO)
// V2-4.2: Removed duplicate bettingHouse field — only bettingHouseSlug remains

model LinkRequest {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation("LinkRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  dealId           String?
  deal             Deal?             @relation(fields: [dealId], references: [id])
  bettingHouseSlug String // V2-4.2: single source of truth
  message          String            @default("") @db.Text
  status           LinkRequestStatus @default(PENDING)
  links            Json              @default("[]") // [{label, url}] — validated via DTO
  // Respostas do formulário quando o deal é kind=FORM (snapshot). Campos marcados
  // como `secret` no formSchema (ex.: senha de terceiro) são gravados CIFRADOS
  // (CryptoService/AES-256-GCM) — só o admin descriptografa na leitura. null p/ LINK.
  formData         Json?
  adminNote        String            @default("") @db.Text
  fulfilledAt      DateTime?
  fulfilledById    String?
  fulfilledBy      User?             @relation("LinkRequestFulfiller", fields: [fulfilledById], references: [id])
  fulfilledByName  String            @default("")

  // ─── Snapshot do CPA resolvido (fonte de verdade enquanto aguarda link no pool)
  // Gravado no create(). O scheduler atribui usando estes valores, NUNCA recalcula.
  // Alteração futura de HouseLinkRule não muda solicitações já snapshotadas.
  resolvedCpa         Decimal?                   @db.Decimal(10, 4)
  resolvedRevshare    Decimal?                   @db.Decimal(10, 4)
  resolvedRuleApplied LinkAssignmentRuleApplied?
  houseRuleId         String? // snapshot histórico (SetNull, nunca cascade)
  houseRule           HouseLinkRule?             @relation(fields: [houseRuleId], references: [id], onDelete: SetNull)
  houseRuleUpdatedAt  DateTime? // versão prática da regra usada
  resolvedAt          DateTime?
  inviterId           String?
  inviterCpa          Decimal?                   @db.Decimal(10, 4)
  rangeReferenceHouse String?
  rangeReferenceCpa   Decimal?                   @db.Decimal(10, 4)
  requiredHouseSlugs  String[]                   @default([])
  missingHouseSlugs   String[]                   @default([])
  blockedReason       String?                    @db.Text
  blockedMetadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkWebhookDeliveries LinkWebhookDelivery[]

  @@index([userId])
  @@index([dealId])
  @@index([status])
  @@index([bettingHouseSlug])
  @@index([houseRuleId])
  @@map("link_requests")
}

// ─── NOTIFICATION ───────────────────────────────────────────
// F05/F19: NotificationType enum | F09: Partial index for unread via migration
// F11: GIN index on metadata via migration

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  metadata  Json? // {bettingHouse, field, oldValue, newValue, prizeId, etc.}
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // F09: Partial index via raw SQL: WHERE read = false
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─── COMMISSION LOG ─────────────────────────────────────────
// F01: Decimal | F15: onDelete SET NULL (preserve audit trail)
// V2-4.1: Added userName/userEmail denormalized (same pattern as AuditLog)

model CommissionLog {
  id              String        @id @default(uuid())
  userId          String?
  user            User?         @relation("CommissionLogUser", fields: [userId], references: [id], onDelete: SetNull)
  userName        String // V2-4.1: denormalized snapshot
  userEmail       String // V2-4.1: denormalized snapshot
  changedById     String?
  changedBy       User?         @relation("CommissionLogChanger", fields: [changedById], references: [id], onDelete: SetNull)
  bettingHouse    String
