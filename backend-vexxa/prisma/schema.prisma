  messages    SupportMessage[]
  assignments SupportConversationAssignment[]

  @@index([affiliateId, status])
  @@index([agentId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("support_conversations")
}

model SupportMessage {
  id                 String              @id @default(uuid())
  conversationId     String
  conversation       SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId           String
  sender             User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  senderRole         MessageSenderRole
  content            String              @db.Text
  attachmentUrl      String?
  attachmentMimeType String?
  attachmentName     String?
  attachmentSize     Int?
  readAt             DateTime?
  createdAt          DateTime            @default(now())
  editedAt           DateTime?

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([senderId])
  @@map("support_messages")
}

model SupportConversationAssignment {
  id             String              @id @default(uuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          User                @relation("AssignmentAgent", fields: [agentId], references: [id], onDelete: Restrict)
  agentName      String
  agentEmail     String
  assignedAt     DateTime            @default(now())
  releasedAt     DateTime?

  @@index([conversationId])
  @@index([agentId, assignedAt(sort: Desc)])
  @@map("support_conversation_assignments")
}

model SupportAgentAvailability {
  id             String    @id @default(uuid())
  agentId        String    @unique
  agent          User      @relation("AgentAvailability", fields: [agentId], references: [id], onDelete: Cascade)
  isOnline       Boolean   @default(false)
  lastAssignedAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("support_agent_availability")
}

// ─── LINK REQUEST / CPA AUTO-ASSIGNMENT ─────────────────────
// Regra configurável por casa para solicitação/atribuição automática de links.
// 1 linha por casa. Substitui CPA manual do líder + timeout de 24h.
model HouseLinkRule {
  id        String       @id @default(uuid())
  houseSlug String       @unique
  house     BettingHouse @relation(fields: [houseSlug], references: [slug])

  // master toggles
  requestEnabled    Boolean @default(true) // casa ativa p/ solicitação
  autoAssignEnabled Boolean @default(true) // atribuição automática

  // cálculo de CPA
  ruleType            LinkRuleType @default(INVITER_DISCOUNT)
  defaultCpa          Decimal      @default(0) @db.Decimal(10, 4) // usuário sem convidante
  fallbackCpa         Decimal      @default(0) @db.Decimal(10, 4) // convidante sem CPA
  inviterCpaThreshold Decimal?     @db.Decimal(10, 4) // limite p/ usar CPA do convidante
  inviterCpaDiscount  Decimal      @default(5) @db.Decimal(10, 4)
  defaultRevshare     Decimal      @default(0) @db.Decimal(10, 4)
  // faixa (Esportiva): [{min,max,cpa}] (min/max null = sem piso/teto)
  rangeReferenceHouse String?
  rangeTiers          Json         @default("[]")

  // toggles de validação
  checkExistingLink         Boolean @default(true)
  checkPendingRequest       Boolean @default(true)
  useInviterCpa             Boolean @default(true)
  applyFallbackNoInviterCpa Boolean @default(true)
  applyDefaultNoInviter     Boolean @default(true)
  blockOnRequiredFail       Boolean @default(true)
  processOldRequests        Boolean @default(false)

  // dependência genérica entre casas
  requireActiveLinkInHouses Boolean  @default(false)
  requiredHouseSlugs        String[] @default([])

  blockMessage  String   @default("") @db.Text
  updatedByName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkRequests LinkRequest[]
  changeLogs   HouseLinkRuleChangeLog[]

  @@index([requestEnabled])
  @@index([autoAssignEnabled])
  @@map("house_link_rules")
}

// Auditoria de domínio das mudanças de regra (além do AuditLog middleware).
model HouseLinkRuleChangeLog {
  id              String         @id @default(uuid())
  houseRuleId     String?
  houseRule       HouseLinkRule? @relation(fields: [houseRuleId], references: [id], onDelete: SetNull)
  houseSlug       String
  adminName       String         @default("")
  changeReason    String?        @db.Text // obrigatório p/ campos financeiros (app layer)
  changes         Json           @default("{}") // { campo: { old, new } }
  blockMessageOld String         @default("")
  blockMessageNew String         @default("")
  createdAt       DateTime       @default(now())

  @@index([houseSlug, createdAt])
  @@map("house_link_rule_change_logs")
}

// Log por solicitação processada (auditoria/suporte).
model LinkAssignmentLog {
  id             String                     @id @default(uuid())
  linkRequestId  String?
  userId         String
  userName       String                     @default("")
  houseSlug      String
  inviterId      String?
  inviterCpa     Decimal?                   @db.Decimal(10, 4)
  assignedCpa    Decimal?                   @db.Decimal(10, 4)
  ruleApplied    LinkAssignmentRuleApplied?
  outcome        LinkAssignmentOutcome
  origin         LinkAssignmentOrigin
  togglesApplied String[]                   @default([])
  requiredHouses String[]                   @default([])
  missingHouses  String[]                   @default([])
  statusBefore   String                     @default("")
  statusAfter    String                     @default("")
  adminName      String                     @default("")
  reason         String?                    @db.Text
  message        String                     @default("") @db.Text
  createdAt      DateTime                   @default(now())

  @@index([linkRequestId])
  @@index([userId, houseSlug])
  @@index([houseSlug, createdAt])
  @@index([origin, createdAt])
  @@index([outcome, createdAt])
  @@map("link_assignment_logs")
}

// Execução de backfill + lock de concorrência por casa.
model BackfillRun {
  id              String            @id @default(uuid())
  houseSlug       String
  status          BackfillRunStatus @default(RUNNING)
  dryRun          Boolean           @default(false)
  adminName       String            @default("")
  reason          String?           @db.Text
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?
  staleAt         DateTime?
  failedReason    String?           @db.Text
  evaluated       Int               @default(0)
  processed       Int               @default(0)
  skipped         Int               @default(0)
  blocked         Int               @default(0)
  waitingPool     Int               @default(0)
  waitingSnapshot Int               @default(0)
  errors          Int               @default(0)
  message         String            @default("") @db.Text

  @@index([houseSlug, status])
  @@index([startedAt])
  @@map("backfill_runs")
}

// ─── CPA PRIZE (Premiação por CPA) ──────────────────────────
// Premiação recorrente por meta de CPA: a cada X CPAs → 1 prêmio.
// Motor recalcula total acumulado vs prêmios já gerados (idempotente).

enum CpaPrizeCountMode {
  INDIVIDUAL // conta só o CPA próprio do usuário
  NETWORK // conta só o CPA da downline (sem o cabeça)
}

// Sem PENDING: todo prêmio gerado pelo motor nasce AVAILABLE.
// Admin atua apenas no fluxo de resgate (aprovar/rejeitar) ou cancelamento manual.
enum CpaPrizeAwardStatus {
  AVAILABLE
  REDEMPTION_REQUESTED
  PAID
  CANCELLED
  REJECTED
}

// Container lógico da regra. Edições não-estruturais mutam aqui; estruturais criam nova versão.
model CpaPrizeRule {
  id               String  @id @default(uuid())
  name             String
  description      String  @default("") @db.Text
  active           Boolean @default(true)
  archived         Boolean @default(false) // sem delete físico quando há histórico
  // Aponta para a versão vigente (config corrente). Sem FK relacional para evitar ciclo.
  currentVersionId String?

  createdById String
  createdBy   User   @relation("CpaPrizeRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CpaPrizeRuleVersion[]
  awards   CpaPrizeAward[]

  @@index([active, archived])
  @@map("cpa_prize_rules")
}

// Snapshot imutável de configuração = um ciclo de contagem.
model CpaPrizeRuleVersion {
  id      String       @id @default(uuid())
  ruleId  String
  rule    CpaPrizeRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version Int

  // null = conta CPA de todas as casas; slug = só dessa casa
  bettingHouse    String?
  bettingHouseRef BettingHouse? @relation(fields: [bettingHouse], references: [slug])

  cpaPerPrize Int // meta
  countMode   CpaPrizeCountMode
  prizeType   PrizeType         @default(OTHER)
  prizeValue  Decimal           @default(0) @db.Decimal(14, 2)
  prizeLabel  String            @default("")
  icon        String            @default("🎯")

  startDate         DateTime  @db.Date
  endDate           DateTime? @db.Date
  // Corte DIÁRIO do início efetivo da contagem (AffiliateData.date é por dia).
  effectiveFromDate DateTime  @db.Date
  supersededAt      DateTime? // null = versão vigente

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress CpaPrizeProgress[]
  awards   CpaPrizeAward[]

  @@unique([ruleId, version])
  @@index([supersededAt])
  @@map("cpa_prize_rule_versions")
}

// Acumulador idempotente por (versão, usuário). Congela ciclo antigo.
model CpaPrizeProgress {
  id            String              @id @default(uuid())
  ruleVersionId String
  ruleVersion   CpaPrizeRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalCpaCounted Int      @default(0)
  awardsGenerated Int      @default(0) // = floor(total/meta) na última avaliação
  lastEvaluatedAt DateTime @default(now())

  ruleId String // denormalizado p/ consultas por regra

  @@unique([ruleVersionId, userId])
  @@index([ruleId])
  @@map("cpa_prize_progress")
}

// Prêmio gerado (instância). Snapshots preservam histórico mesmo após edição da regra.
model CpaPrizeAward {
  id            String              @id @default(uuid())
  ruleId        String
  rule          CpaPrizeRule        @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleVersionId String
  ruleVersion   CpaPrizeRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  userName      String // denormalizado

  bettingHouse String? // snapshot
  countMode    CpaPrizeCountMode // snapshot
  cpaThreshold Int // meta no momento da geração
  cycleIndex   Int // 1º, 2º… prêmio dentro da versão

  prizeType  PrizeType @default(OTHER) // snapshot
  prizeValue Decimal   @default(0) @db.Decimal(14, 2) // snapshot
  prizeLabel String    @default("") // snapshot

  status          CpaPrizeAwardStatus @default(AVAILABLE)
  balanceCredited Boolean             @default(false)

  redemptionRequestedAt DateTime?
  resolvedAt            DateTime?
  resolvedById          String? // admin (denormalizado, sem FK)
  rejectionReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ruleVersionId, userId, cycleIndex]) // trava dura anti-duplicação
  @@index([status])
  @@index([userId])
  @@index([ruleId])
  @@map("cpa_prize_awards")
}

// Auditoria de domínio imutável (mais rica que AuditLog HTTP-shaped).
model CpaPrizeLog {
  id            String  @id @default(uuid())
  ruleId        String?
  ruleVersionId String?
  userId        String? // afetado
  adminId       String? // ação manual

  // CPA_COUNTED | PRIZE_GENERATED | REMAINDER | REDEMPTION_REQUESTED |
  // REDEMPTION_APPROVED | REDEMPTION_REJECTED | AWARD_CANCELLED |
  // RULE_CREATED | RULE_UPDATED | RULE_VERSIONED | RULE_TOGGLED |
  // MANUAL_RECALC | MANUAL_ADJUSTMENT
  event        String
  bettingHouse String?

  cpaBefore Int?
  cpaAdded  Int?
  cpaAfter  Int?

  prizesGenerated     Int?
  totalValueGenerated Decimal? @db.Decimal(14, 2)

  note     String @default("") @db.Text
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ruleId, createdAt])
  @@index([event])
  @@map("cpa_prize_logs")
}

// ─── WHATSAPP (Evolution GO) ────────────────────────────────
// Envio automático de comprovantes de saque para um grupo WhatsApp.
// Config e estado de runtime são tabelas singleton separadas.

// Configuração editável pelo admin (1 linha singleton).
model WhatsappSettings {
  id                       String   @id @default(uuid())
  instanceName             String   @default("")
  // Token da instância retornado/definido no /instance/create — usado como
  // header `apikey` nas chamadas instance-scoped. Nunca exposto ao frontend.
  instanceToken            String?
  selectedGroupId          String?
  selectedGroupName        String?
  messageTemplate          String   @default("") @db.Text
  sendMedia                Boolean  @default(true)
  delayMinSeconds          Int      @default(20)
  delayMaxSeconds          Int      @default(90)
  maxAttempts              Int      @default(5)
  maxWaitConnectionMinutes Int      @default(1440)
  failureCooldownSeconds   Int      @default(300)
  enabled                  Boolean  @default(true)
  // Alerta "planilha de links cheia": número WhatsApp de destino, limite de
  // links livres que dispara o aviso, e flag de habilitado. O dedup ("uma vez")
  // é feito em Redis, não aqui.
  linkPoolAlertNumber      String?
  linkPoolAlertThreshold   Int      @default(0)
  linkPoolAlertEnabled     Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("whatsapp_settings")
}

// Estado de conexão / circuit breaker (1 linha singleton, atualizada pelo poll).
model WhatsappConnectionState {
  id                       String    @id @default(uuid())
  status                   String    @default("close") // open | close | connecting | error
  phoneNumber              String?
  lastConnectedAt          DateTime?
  lastDisconnectedAt       DateTime?
  lastDisconnectNotifiedAt DateTime? // cooldown da notificação push
  consecutiveFailures      Int       @default(0)
  circuitOpenUntil         DateTime? // circuit breaker: envios pausados até aqui
  lastErrorAt              DateTime?
  updatedAt                DateTime  @updatedAt

  @@map("whatsapp_connection_state")
}

// Histórico de cada comprovante enviado (ou tentativa). Colunas denormalizadas
// (sem relação Prisma p/ User/Withdrawal) — guarda só o necessário p/ auditoria.
model WhatsappSendLog {
  id                     String             @id @default(uuid())
  withdrawalId           String? // null p/ envios de teste; dedupe agora por (withdrawalId, groupId)
  isTest                 Boolean            @default(false)
  userId                 String?
  userName               String             @default("")
  userEmail              String?
  amount                 Decimal?           @db.Decimal(14, 2)
  groupId                String?
  groupName              String?
  message                String             @db.Text
  status                 WhatsappSendStatus @default(PENDING)
  // nº de tentativas REAIS de envio à Evolution (não inclui esperas por conexão)
  attempts               Int                @default(0)
  waitingConnectionSince DateTime?
  pausedSince            DateTime?
  lastError              String?            @db.Text
  jobId                  String?
  // Resposta resumida/auditoria — NUNCA salvar apikey/token/headers/QR
  evolutionResponse      Json?
  sentAt                 DateTime?
  createdByAdminId       String? // só em ações manuais (retry/teste); null no automático
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  // Um comprovante é enviado para N grupos → 1 log por (saque, grupo). Substitui o
  // antigo @unique(withdrawalId). NULL em withdrawalId (testes) é distinto no Postgres.
  @@unique([withdrawalId, groupId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([userEmail])
  @@map("whatsapp_send_logs")
}

// Grupos/comunidades de destino dos comprovantes. O MESMO comprovante é enviado
// para todos. groupId @unique garante que não há repetição de grupo salvo.
model WhatsappTargetGroup {
  id         String   @id @default(uuid())
  groupId    String   @unique // JID "...@g.us"
  name       String   @default("")
  pictureUrl String? // foto do grupo (cache p/ exibir no admin)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("whatsapp_target_groups")
}
