# Telegram BotFather token
TELEGRAM_BOT_TOKEN=your_bot_token

# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_IDS=123456789

# Same Postgres URL as backend-vexxa
DATABASE_URL=postgresql://user:password@localhost:5432/vallex_db2

# Betboard API (consulta ao vivo nos painéis) — período fixo: início do mês atual
BETBOARD_ENABLED=true

# JSON array — bookmarkerIds são resolvidos automaticamente do Postgres quando possível
# BETBOARD_ACCOUNTS=[{"name":"Vallex","email":"...@afiliadosexternos.com","password":"***","origin":"https://afiliadosexternos.mgaffiliates.site","houses":["superbet","betano"]},{"name":"Jairo","email":"jairoex@...","password":"***","origin":"https://afiliadosexternos.mgaffiliates.site","houses":["superbet"]},{"name":"Vallex Admin","email":"admin@mtafiliates.com.br","password":"***","origin":"https://vallexgroup.mgaffiliates.site","referer":"https://vallexgroup.mgaffiliates.site/","houses":["esportivabet","sportingbet"]}]
